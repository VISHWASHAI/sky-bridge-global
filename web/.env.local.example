# Copy to .env.local and fill with your Supabase project values
# (Supabase dashboard -> Project Settings -> API)
# These are safe to expose to the browser; Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Admin inbox (/admin) — SERVER ONLY, never exposed to the browser ---
# Supabase dashboard -> Project Settings -> API -> service_role secret key.
# This bypasses Row Level Security, so keep it secret (server env only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# A password you choose to log into /admin.
ADMIN_PASSWORD=choose-a-strong-password

# --- Public site URL ---
# Used for SEO metadata, sitemap, and the shareable customer tracking links.
# Set this to your custom domain once connected (e.g. https://skybridgeglobals.com).
# Leave unset to fall back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=https://skybridgeglobals.com

# --- SEO / Analytics (optional) ---
# Google Analytics 4 measurement ID (Analytics -> Admin -> Data streams). When
# set, the GA tag is added site-wide. Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Search Console verification token (the content value of the
# "google-site-verification" meta tag). Adds the verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-search-console-token

# --- Tawk.to live chat (optional) ---
# From your Tawk.to embed code: https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
# The widget loads only when BOTH are set. Set position (left/right) in the
# Tawk.to dashboard: Administration -> Chat Widget -> Appearance.
NEXT_PUBLIC_TAWK_PROPERTY_ID=your-tawk-property-id
NEXT_PUBLIC_TAWK_WIDGET_ID=your-tawk-widget-id
